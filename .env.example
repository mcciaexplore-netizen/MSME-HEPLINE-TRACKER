# Postgres (e.g. Neon). On Vercel, adding Neon from the Storage tab sets DATABASE_URL for you.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# A separate database that `npm test` and scripts/acceptance.ts wipe on every run. Never point it at real data.
TEST_DATABASE_URL="postgresql://user:password@host/testdb?sslmode=require"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="choose-a-strong-password"
SESSION_SECRET="replace-with-a-long-random-string-before-deploying"
